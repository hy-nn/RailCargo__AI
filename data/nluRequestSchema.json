{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RailCargoAI NLU Request",
  "description": "레일카고 AI parseRequest() 단계에서 Gemini가 반환해야 하는 구조화 요청 형식",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "SEARCH_POOL",
        "CHECK_BOOKING",
        "UNKNOWN"
      ],
      "description": "사용자의 요청 의도"
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "NEEDS_CLARIFICATION",
        "UNSUPPORTED"
      ],
      "description": "다음 처리 단계로 진행 가능한지 나타내는 상태"
    },
    "serviceTab": {
      "type": "string",
      "enum": [
        "RAIL_ONLY",
        "RAIL_TRUCKER",
        "FULL_PACKAGE"
      ],
      "description": "사용자가 선택한 서비스 탭. 자연어에서 추측하지 않고 화면 상태를 우선 사용"
    },
    "requestedDepartureDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "사용자가 요청한 철도 출발 희망일. YYYY-MM-DD 형식"
    },
    "requestedArrivalByDate": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "사용자가 요청한 최종 목적지 도착 기한. YYYY-MM-DD 형식"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "originText": {
          "type": [
            "string",
            "null"
          ],
          "description": "사용자가 표현한 출발지 원문 또는 정규화된 지명"
        },
        "stationId": {
          "type": [
            "string",
            "null"
          ],
          "description": "후속 매핑 단계에서 채우는 출발역 ID. parseRequest 단계에서는 null"
        }
      },
      "required": [
        "originText",
        "stationId"
      ]
    },
    "finalDestination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destinationText": {
          "type": [
            "string",
            "null"
          ],
          "description": "사용자가 표현한 최종 목적지"
        },
        "city": {
          "type": [
            "string",
            "null"
          ],
          "description": "문장에서 명확히 확인되는 시·군 단위 지역명"
        },
        "mappedStationId": {
          "type": [
            "string",
            "null"
          ],
          "description": "후속 매핑 단계에서 채우는 도착 화물취급역 ID. parseRequest 단계에서는 null"
        }
      },
      "required": [
        "destinationText",
        "city",
        "mappedStationId"
      ]
    },
    "cargo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "화물 품목 또는 설명"
        },
        "packageType": {
          "type": [
            "string",
            "null"
          ],
          "description": "PALLET 등 포장 형태. 확인되지 않으면 null"
        },
        "packageCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "포장 단위 수량"
        },
        "volumeCBM": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "화물 부피. 루베는 CBM으로 정규화"
        },
        "weightKg": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "화물 중량. 톤은 kg으로 정규화"
        }
      },
      "required": [
        "description",
        "packageType",
        "packageCount",
        "volumeCBM",
        "weightKg"
      ]
    },
    "missingFields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "누락되거나 의미 확인이 필요한 필드 경로"
    },
    "followUpQuestion": {
      "type": [
        "string",
        "null"
      ],
      "description": "추가 확인이 필요한 경우 사용자에게 제시할 한 개의 간결한 질문"
    }
  },
  "required": [
    "intent",
    "status",
    "serviceTab",
    "requestedDepartureDate",
    "requestedArrivalByDate",
    "origin",
    "finalDestination",
    "cargo",
    "missingFields",
    "followUpQuestion"
  ]
}
